<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/connect_title"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="@string/connect_sub"
            android:textColor="@color/muted"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/netBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/foundLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡 PCs on this network"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/foundStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:id="@+id/foundList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/scanBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_qr"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/savedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/saved_pcs"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:id="@+id/savedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>
</ScrollView>
